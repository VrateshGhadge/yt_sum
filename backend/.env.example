# Copy to .env.local and fill in real values. Never commit .env.local.
#   cp backend/.env.example backend/.env.local

# --- Clerk (required) -------------------------------------------------------
# From https://dashboard.clerk.com -> API Keys. The frontend and backend must
# belong to the SAME Clerk instance or every request returns 401.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- MongoDB (required for history) ----------------------------------------
# Matches compose.yaml. Start it with: docker compose up -d
MONGO_URL=mongodb://127.0.0.1:27017/ytsum

# --- AI: OpenRouter free models (required) ----------------------------------
# Free key from https://openrouter.ai/keys — no credit card, no billing.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=nvidia/nemotron-3.5-lightning:free
AI_FALLBACK_MODEL=openrouter/free

# --- Server (optional) ------------------------------------------------------
# PORT=3000
# Comma-separated origins allowed by CORS (Vite dev server).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,https://summifyapp.netlify.app

